# Copy to .env and fill in. Every value can also be supplied as a plain environment variable.

# --- Inbound mail (IMAP) -------------------------------------------------------
# The mailbox the agent watches for requests such as
# "Hi Agent, can you give me Other Documents files from M12205?"
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your-agent@gmail.com
IMAP_PASSWORD=app-password-here
IMAP_FOLDER=INBOX

# --- Outbound mail (SMTP) ------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-agent@gmail.com
SMTP_PASSWORD=app-password-here
SMTP_FROM=your-agent@gmail.com
# STARTTLS on 587 (default) or implicit TLS on 465
SMTP_USE_SSL=false

# --- Behaviour -----------------------------------------------------------------
MAX_DOCUMENTS=10
MAX_ATTACHMENT_MB=20
POLL_INTERVAL_SECONDS=60
HEADLESS=true
# "chromium" uses Playwright's bundled browser; "chrome" uses an installed Google Chrome.
BROWSER_CHANNEL=chromium
# Comma separated allow-list of sender addresses or @domains. Empty = anyone may email the agent.
ALLOWED_SENDERS=
RATE_LIMIT_PER_SENDER_PER_HOUR=6
WORK_DIR=./out

# --- Optional LLM (free-form request parsing + reply polishing) -----------------
# none | openai | anthropic
LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
